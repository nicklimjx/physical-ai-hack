# Server-only provider settings. Copy to .env and restart the npm process after edits.
# Existing shell variables take priority. Blank API keys keep the labelled fallback.
JEV_API_KEY=
# Optional exact JEV model identifier; blank uses the adapter's documented default.
JEV_MODEL=
OPENAI_API_KEY=
# Exact account-accessible model ID; this sample uses Luna structured responses.
OPENAI_MODEL=gpt-6-luna
# Luna supports none, low, medium, high, xhigh, max. Omit to use the provider default.
OPENAI_REASONING_EFFORT=low
# Fast is a premium processing request, not a model suffix or guaranteed serving tier.
# Omit this setting for normal provider/project defaults; restart after changes.
OPENAI_SERVICE_TIER=fast
# Combined reasoning + visible output budget; positive integer from 1 to 32768.
OPENAI_MAX_COMPLETION_TOKENS=2048
ELEVENLABS_API_KEY=
# Your accessible ElevenLabs voice identifier.
ELEVENLABS_VOICE_ID=
